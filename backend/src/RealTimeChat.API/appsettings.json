{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=ClaudeRealTimeChat;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "CHANGE-ME-dev-only-key-at-least-32-characters-long!",
    "Issuer": "RealTimeChat",
    "Audience": "RealTimeChat.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "FileStorage": {
    "MaxFileSizeMB": 25,
    "MaxAvatarSizeMB": 5,
    "AllowedExtensions": [],
    "BlockedExtensions": [
      ".exe", ".bat", ".cmd", ".com", ".msi", ".scr", ".ps1", ".vbs", ".js", ".mjs", ".jar",
      ".sh", ".dll", ".html", ".htm", ".svg", ".xhtml", ".php", ".asp", ".aspx"
    ],
    "ImageExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp" ]
  },
  "Cors": { "Origins": [ "http://localhost:5173" ] },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*"
}
